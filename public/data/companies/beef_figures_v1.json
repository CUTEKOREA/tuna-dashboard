3\" height=\"88\" fill=\"#E2E9F0\" stroke=\"#1B3A5C\" stroke-width=\".8\"/>\n<text x=\"373.2\" y=\"42\" text-anchor=\"middle\" font-size=\"11\" font-weight=\"700\" fill=\"#14181B\">국내 가공</text>\n<text x=\"373.2\" y=\"76\" text-anchor=\"middle\" font-size=\"9\" fill=\"#14181B\">포장처리, 절단,</text>\n<text x=\"373.2\" y=\"88\" text-anchor=\"middle\" font-size=\"9\" fill=\"#14181B\">양념, 식품</text>\n<text x=\"373.2\" y=\"100\" text-anchor=\"middle\" font-size=\"9\" fill=\"#14181B\">제조업체</text>\n<line x1=\"419.3\" y1=\"64\" x2=\"432.3\" y2=\"64\" stroke=\"#6B757B\" stroke-width=\"1.4\" marker-end=\"url(#ah)\"/>\n<rect x=\"435.3\" y=\"20\" width=\"88.3\" height=\"88\" fill=\"#1B3A5C\" stroke=\"#1B3A5C\" stroke-width=\".8\"/>\n<text x=\"479.5\" y=\"42\" text-anchor=\"middle\" font-size=\"11\" font-weight=\"700\" fill=\"#FCFCFA\">도매·유통</text>\n<text x=\"479.5\" y=\"76\" text-anchor=\"middle\" font-size=\"9\" fill=\"#FCFCFA\">식육 도매상,</text>\n<text x=\"479.5\" y=\"88\" text-anchor=\"middle\" font-size=\"9\" fill=\"#FCFCFA\">식자재 유통사,</text>\n<text x=\"479.5\" y=\"100\" text-anchor=\"middle\" font-size=\"9\" fill=\"#FCFCFA\">물류업체</text>\n<line x1=\"525.7\" y1=\"64\" x2=\"538.7\" y2=\"64\" stroke=\"#6B757B\" stroke-width=\"1.4\" marker-end=\"url(#ah)\"/>\n<rect x=\"541.7\" y=\"20\" width=\"88.3\" height=\"88\" fill=\"#E2E9F0\" stroke=\"#1B3A5C\" stroke-width=\".8\"/>\n<text x=\"585.8\" y=\"42\" text-anchor=\"middle\" font-size=\"11\" font-weight=\"700\" fill=\"#14181B\">소매·외식</text>\n<text x=\"585.8\" y=\"76\" text-anchor=\"middle\" font-size=\"9\" fill=\"#14181B\">정육점, 마트,</text>\n<text x=\"585.8\" y=\"88\" text-anchor=\"middle\" font-size=\"9\" fill=\"#14181B\">식당, 급식업체</text>\n</svg>\n</div>",
