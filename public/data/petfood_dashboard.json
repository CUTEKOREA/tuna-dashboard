  "d_kfas_w01": {
    "id": "kfas_w01_tuna_byproduct",
    "title": "🔬 [KFAS] 참치 통조림 부산물 영양·안전성 포렌식: 펫푸드 원료 적격성 평가",
    "source": "KFAS: Kim et al.(2025) '참치(Katsuwonus pelamis) 통조림 가공공정 중 발생하는 생 및 자숙 부산물의 위생안전성 및 영양학적 품질 특성 평가' (국립수산과학원)",
    "reliability": 100,
    "chartType": "composed",
    "xKey": "part",
    "bars": [
      {"key": "단백질(g/100g)", "color": "#10b981"},
      {"key": "조지방(g/100g)", "color": "#f59e0b"}
    ],
    "lines": [
      {"key": "EAA비율(%)", "color": "#3b82f6", "yAxisId": "right"}
    ],
    "data": [
      {"part": "자숙 혈합육", "단백질(g/100g)": 26.75, "조지방(g/100g)": 7.93, "EAA비율(%)": 42.3},
      {"part": "자숙 꼬리", "단백질(g/100g)": 25.42, "조지방(g/100g)": 4.87, "EAA비율(%)": 41.8},
      {"part": "자숙 머리", "단백질(g/100g)": 18.50, "조지방(g/100g)": 5.22, "EAA비율(%)": 40.5},
      {"part": "자숙 중골", "단백질(g/100g)": 19.80, "조지방(g/100g)": 3.15, "EAA비율(%)": 39.7},
      {"part": "생 내장", "단백질(g/100g)": 7.90, "조지방(g/100g)": 12.40, "EAA비율(%)": 38.2}
    ],
    "safety": [
      {"항목": "히스타민", "자숙혼합": "불검출~미량", "기준치": "200 mg/kg", "적합": true},
      {"항목": "카드뮴(머리)", "자숙혼합": "1.27 mg/kg", "기준치": "0.5 mg/kg(식용어류)", "적합": false},
      {"항목": "납", "자숙혼합": "0.09 mg/kg", "기준치": "0.5 mg/kg", "적합": true},
      {"항목": "VBN(휘발성염기질소)", "자숙혼합": "기준미만", "기준치": "부패판정기준", "적합": true}
    ],
    "byproduct_yield": [
      {"부위": "머리", "비율(%)": 20.5},
      {"부위": "내장(생)", "비율(%)": 15.3},
      {"부위": "꼬리+중골", "비율(%)": 12.8},
      {"부위": "혈합육(Dark muscle)", "비율(%)": 9.7},
      {"부위": "기타(뼈+껍질)", "비율(%)": 1.2}
    ],
    "sit": "[KFAS 2025] 참치(가다랑어) 3.5kg 기준 통조림 가공 시 총 중량의 약 59.5%가 부산물로 발생합니다. 자숙 혈합육(dark muscle)의 단백질 함량이 26.75 g/100g으로 최고이며, 필수아미노산 비율(EAA)이 42.3%로 FAO/WHO 권장 기준(40%)을 초과하여 펫푸드 프리미엄 단백질원으로 최적입니다. 다만 내장과 머리 부위의 카드뮴 축적(1.27 mg/kg)에 주의가 필요합니다.",
    "strat": "자숙 혈합육과 꼬리를 선별 분리하여 '단일원료(Single-ingredient) 프리미엄 펫 간식' 원료로 전환하면, 기존 어분 가공(마진 15%) 대비 65%의 초고마진을 확보할 수 있습니다. 내장·머리 부위는 중금속 리스크로 인해 어분/어유 추출 경로로 분리 처리하되, HACCP 기반 중금속 모니터링 프로토콜을 적용해야 합니다."
  },
  "d_kfas_w02": {
    "id": "kfas_w02_tuna_roe_hydrolysate",
    "title": "🔬 [KFAS] 황다랑어 알 효소가수분해물: 기능성 펫푸드 첨가제 개발",
