{
  "name": "tuna-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "simulate": "node scripts/simulate_webhooks.js",
    "sync:consignment": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sync_consignment_data.ts",
    "sync:briefing": "python3 scripts/sync_daily_briefing.py",
    "sync:gmts": "python3 scripts/build_gmts_dashboard.py",
    "sync:gmts-monthly": "python3 scripts/build_gmts_monthly.py",
    "test:gmts-monthly-sync": "python3 scripts/test_build_gmts_monthly.py",
    "sync:bangkok": "bash scripts/sync_bangkok_report.sh",
    "sync:singapore-mgo": "python3 scripts/sync_singapore_mgo.py",
    "test:singapore-mgo-sync": "python3 scripts/test_sync_singapore_mgo.py",
    "sync:fleet-daily": "python3 scripts/sync_fleet_daily_reports.py",
    "ops:scan": "python3 scripts/dashboard_daily_operator.py scan",
    "ops:report": "python3 scripts/dashboard_daily_operator.py report",
    "test:daily-operator": "python3 scripts/test_dashboard_daily_operator.py",
    "test:fleet-daily-sync": "python3 scripts/test_sync_fleet_daily_reports.py",
    "test:weekly-data-sync": "python3 scripts/test_sync_cosmo_weekly.py && python3 scripts/test_sync_reefer_weekly.py",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:unloading-history": "node e2e/run-unloading-history.js",
    "check:api-cache": "node scripts/audit_api_cache_policy.mjs",
    "check:fleet-client-leak": "node scripts/check_fleet_client_leak.mjs",
    "check:fleet-client-leak:ci": "node scripts/check_fleet_client_leak.mjs --allow-synthetic",
    "check:bundle": "node scripts/check_route_bundle_budget.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:daily-operator && npm run test:fleet-daily-sync && npm run test:weekly-data-sync && npm run test:singapore-mgo-sync && npm test && npm run check:api-cache && npm run build && npm run check:fleet-client-leak:ci && npm run check:bundle && npm run check:report-tables",
    "mackerel": "python3 scripts/mackerel/build.py && python3 scripts/mackerel/validate_provenance.py",
    "mackerel:test": "python3 scripts/mackerel/test_build.py",
    "mackerel:ledger": "python3 scripts/mackerel/build_ledger.py && python3 scripts/mackerel/validate_consolidation.py",
    "mackerel:score": "python3 scripts/mackerel/score_4axis.py",
    "check:enrich": "python3 scripts/tests/check_enrich_verbatim.py",
    "check:report-tables": "python3 scripts/check_report_tables.py"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.5",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.101.1",
    "echarts": "^6.0.0",
    "framer-motion": "^12.38.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "nodemailer": "^9.0.5",
    "pretendard": "^1.3.9",
    "puppeteer": "^24.42.0",
    "react": "19.2.4",
    "react-countup": "^6.5.3",
    "react-dom": "19.2.4",
    "react-globe.gl": "^2.37.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1",
    "server-only": "0.0.1",
    "three": "^0.183.2",
    "xlsx": "^0.18.5",
    "yahoo-finance2": "^3.14.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.183.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "zod": "^4.4.3"
  }
}
